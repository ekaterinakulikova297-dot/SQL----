-- Создание таблиц
CREATE TABLE users (
    user_id INT PRIMARY KEY,
    email VARCHAR(100),
    child_name VARCHAR(50),
    child_age_years INT,
    status VARCHAR(20)
);

CREATE TABLE orders (
    order_id INT PRIMARY KEY,
    user_id INT,
    order_date DATE,
    total_amount DECIMAL(10,2),
    status VARCHAR(20)
);

