    user_id INT PRIMARY KEY,
    child_age_years INT,
    registration_date DATE,
    status VARCHAR(20)
);

CREATE TABLE email_logs_cohort (
    log_id INT PRIMARY KEY,
    user_id INT,
    event_type VARCHAR(20),
    event_date DATE
);

