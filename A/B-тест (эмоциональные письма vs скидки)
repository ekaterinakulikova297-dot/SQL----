-- Таблицы для A/B-теста
CREATE TABLE users_ab (
    user_id INT PRIMARY KEY,
    email VARCHAR(100),
    child_name VARCHAR(50),
    status VARCHAR(20)
);

CREATE TABLE campaign_members_ab (
    member_id INT PRIMARY KEY,
    campaign_id INT,
    user_id INT,
    variant VARCHAR(1),
    sent_date TIMESTAMP
);

CREATE TABLE email_logs_ab (
    log_id INT PRIMARY KEY,
    user_id INT,
    event_type VARCHAR(20),
    event_date TIMESTAMP
);

CREATE TABLE orders_ab (
    order_id INT PRIMARY KEY,
    user_id INT,
    order_date DATE,
    status VARCHAR(20)
);

