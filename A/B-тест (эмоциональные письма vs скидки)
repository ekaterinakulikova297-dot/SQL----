-- Аналитический запрос A/B-теста
WITH ab_data AS (
    SELECT 
        cm.variant,
        COUNT(DISTINCT cm.user_id) AS total_sent,
        COUNT(DISTINCT CASE WHEN l.event_type = 'open' THEN l.user_id END) AS opened,
        COUNT(DISTINCT CASE WHEN l.event_type = 'click' THEN l.user_id END) AS clicked,
        COUNT(DISTINCT CASE WHEN o.order_id IS NOT NULL THEN o.user_id END) AS converted
    FROM campaign_members_ab cm
    LEFT JOIN email_logs_ab l ON cm.user_id = l.user_id AND l.event_date <= cm.sent_date + INTERVAL '7 days'
    LEFT JOIN orders_ab o ON cm.user_id = o.user_id AND o.order_date BETWEEN cm.sent_date AND cm.sent_date + INTERVAL '14 days'
    GROUP BY cm.variant
)
SELECT 
    variant,
    total_sent,
    opened,
    ROUND(100.0 * opened / total_sent, 2) AS open_rate,
    clicked,
    converted,
    ROUND(100.0 * converted / total_sent, 2) AS conversion_rate
FROM ab_data
ORDER BY variant;
