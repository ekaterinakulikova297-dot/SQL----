-- Воронка
WITH funnel AS (
    SELECT 
        cart_id,
        MAX(CASE WHEN event_type = 'email_sent' AND step_number = 1 THEN 1 ELSE 0 END) AS step1_sent,
        MAX(CASE WHEN event_type = 'email_open' AND step_number = 1 THEN 1 ELSE 0 END) AS step1_open,
        MAX(CASE WHEN event_type = 'email_click' AND step_number = 1 THEN 1 ELSE 0 END) AS step1_click,
        MAX(CASE WHEN event_type = 'email_sent' AND step_number = 2 THEN 1 ELSE 0 END) AS step2_sent,
        MAX(CASE WHEN event_type = 'email_open' AND step_number = 2 THEN 1 ELSE 0 END) AS step2_open,
        MAX(CASE WHEN event_type = 'order_created' THEN 1 ELSE 0 END) AS converted
    FROM cart_events
    GROUP BY cart_id
)
SELECT 
    COUNT(*) AS total_carts,
    SUM(step1_sent) AS step1_sent,
    SUM(step1_open) AS step1_opened,
    ROUND(100.0 * SUM(step1_open) / NULLIF(SUM(step1_sent), 0), 2) AS step1_open_rate,
    SUM(step2_sent) AS step2_sent,
    SUM(step2_open) AS step2_opened,
    ROUND(100.0 * SUM(step2_open) / NULLIF(SUM(step2_sent), 0), 2) AS step2_open_rate,
    SUM(converted) AS converted,
    ROUND(100.0 * SUM(converted) / NULLIF(SUM(step1_sent), 0), 2) AS conversion_rate
FROM funnel;
